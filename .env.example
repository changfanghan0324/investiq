# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.
#
# Both variables are server-only credentials, read exclusively by modules under
# src/server/. Never prefix them with NEXT_PUBLIC_ — that would publish the
# value in the browser bundle.

# Massive API key. Required for live backtests: ordinary dividend history and
# corporate-action (split) verification.
MASSIVE_API_KEY=

# Google Gemini API key. Optional. Calculations, charts, and PDF export all work
# without it; only the report-grounded AI explainer requires it.
GEMINI_API_KEY=

# Public-display licensing acknowledgement (Production only). The live data sources
# (Yahoo Finance, Massive) carry redistribution and public-display restrictions, so
# a public production deployment FAILS CLOSED: live and derived market data are not
# served to end users, and every live market-data route returns a neutral
# service-unavailable message, while demo mode keeps working. Local and preview
# development are ungated, so you may use personal credentials for PRIVATE testing.
#
# This flag does NOT grant any rights. Setting it only records that YOU have
# confirmed you already hold them. Set it to exactly `true` ONLY after you have
# secured written rights that cover public end-user display AND derived analytics
# for EVERY data source in use. A durable, deployment-wide provider-call quota
# limiter is also required before licensed public live mode (the Vercel WAF is a
# per-client abuse guard, not a shared provider-quota limiter). It is server-only —
# never prefix it with NEXT_PUBLIC_, and never expose its value.
MARKET_DATA_PUBLIC_DISPLAY_LICENSE_CONFIRMED=

# SEC EDGAR contact / User-Agent. SEC's fair-access policy asks every automated
# client to identify itself with a truthful contact. This is NOT a secret and grants
# no special access — SEC company data is public and requires no key. Set it to a real
# contact string, e.g. "InvestIQ/1.0 (you@example.com)". If unset, a neutral default
# User-Agent is sent. It is server-only; never prefix it with NEXT_PUBLIC_.
SEC_USER_AGENT=

# Distributed rate-limit readiness flag (Production only). Rate limiting for the
# provider-backed API routes is enforced by Vercel's WAF via @vercel/firewall. Those rules
# are published in the Vercel dashboard as an external deployment step (see the
# "Rate limiting" runbook in README.md). Until the rules are live, leave this
# unset: production then FAILS CLOSED with a neutral 503 before any provider
# work. Set it to exactly `true` only after publishing the shared WAF rule:
#   - rule name: investiq-provider-backed-api
#   - condition: Rate Limit API ID equals investiq-provider-backed-api
#   - fixed window: 60 requests / 60 seconds, keyed by client IP
# The single shared edge bucket is a free-plan-compatible abuse boundary. It is
# intentionally coarser than independent route budgets. Outside production,
# route-specific in-process fallback budgets are used (never a security boundary).
RATE_LIMIT_WAF_READY=

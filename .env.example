# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.
#
# Both variables are server-only credentials, read exclusively by modules under
# src/server/. Never prefix them with NEXT_PUBLIC_ — that would publish the
# value in the browser bundle.

# Massive API key. Required for live backtests: ordinary dividend history and
# corporate-action (split) verification.
MASSIVE_API_KEY=

# Google Gemini API key. Optional. Calculations, charts, and PDF export all work
# without it; only the report-grounded AI explainer requires it.
GEMINI_API_KEY=
